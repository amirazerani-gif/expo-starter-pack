# your production server base URL, used by production build.
EXPO_PUBLIC_API_BASE_URL=https://REPLACE_WITH_PROD_DOMAIN/api

# your development server base URL, used by dev build during development. 
# set this to your LAN IP to use the local mock server for reviewing the template .
EXPO_PUBLIC_API_DEV_URL=http://YOUR_LAN_IP:4010/api

# client will automatically pick the development or production URL based on this boolean.
# set this to true to use the development URL, false to use the production URL.
EXPO_PUBLIC_IS_TESTING=true

# this is where gen:api reads the spec from. defaults to the local openapi/openapi.yaml file for local development. 
# you can set this to a remote URL to generate types from youre actual server spec.
OPENAPI_URL=